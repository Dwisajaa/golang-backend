# ============================================================
# golang-backend environment example.
# Copy to .env for local convenience only — values are read from
# the process environment in production (docker compose --env-file).
# Never commit a real .env.
# ============================================================

# Application
APP_ENV=development        # development | production | testing
APP_PORT=8080

# CORS allow-list (comma-separated). Empty disables CORS headers.
CORS_ALLOWED_ORIGINS=
# Strict JSON body cap in bytes (default 1 MiB).
MAX_BODY_BYTES=1048576

# MySQL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=apidw
DATABASE_USER=apidw
DATABASE_PASSWORD=change-me

# OTP (mirrors Laravel OTP_EXPIRATION_MINUTES / OTP_MAX_ATTEMPTS)
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Mail — leave SMTP_HOST empty for the log mailer (Laravel MAIL_MAILER=log parity)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=api-dwidev