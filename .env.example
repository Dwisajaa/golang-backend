# ============================================================
# golang-backend environment example.
# Copy to .env for local convenience only — values are read from
# the process environment in production (docker compose --env-file).
# Never commit a real .env.
# ============================================================

# Application
APP_ENV=development        # development | production | testing
APP_PORT=8080

# MySQL
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=apidw
DATABASE_USER=apidw
DATABASE_PASSWORD=change-me